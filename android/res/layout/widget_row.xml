<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingTop="5dp" android:paddingBottom="5dp" android:paddingStart="4dp" android:paddingEnd="4dp">
    <TextView android:id="@+id/r_time" android:layout_width="46dp" android:layout_height="wrap_content"
        android:textColor="@color/w_muted" android:textSize="13sp" />
    <TextView android:id="@+id/r_subj" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:textColor="@color/w_text" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/r_room" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/w_muted" android:textSize="13sp" />
</LinearLayout>
